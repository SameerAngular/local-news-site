---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const allPosts = await getCollection("news", ({ data }) => !data.draft);
const posts = allPosts.sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---
<BaseLayout title="Local News">
  {posts.length === 0 && <p>No stories yet. Publish your first one from /admin.</p>}
  {posts.map((post) => (
    <div class="post-card">
      <div class="meta">
        {post.data.category ?? "News"} · {post.data.date.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}
      </div>
      <h2><a href={`/news/${post.slug}/`}>{post.data.title}</a></h2>
      {post.data.summary && <p class="summary">{post.data.summary}</p>}
    </div>
  ))}
</BaseLayout>
